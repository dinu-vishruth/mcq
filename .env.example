# --- LLM key (required for quiz generation) --------------------------------
# Groq (recommended, generous free tier). Keys look like `gsk_...`:
#   https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# gpt-oss is a reasoning model: it burns hidden thinking tokens before writing
# the answer, which can exhaust the output budget and make the provider reject
# the response as invalid JSON. "low" caps that. Set empty to omit the
# parameter entirely, or use medium/high for harder material.
# LLM_REASONING_EFFORT=low

# NOTE ON SPELLING: Groq (the inference host, `gsk_` keys) and Grok (xAI's
# model) differ by one letter. Both GROQ_* and GROK_* are accepted, so an
# existing GROK_API_KEY keeps working. Do not set a variable to an empty
# value -- leave it out entirely, or it is treated as unset.
#
# Alternatives -- set exactly one of these instead of GROQ_API_KEY:
#   XAI_API_KEY=          # xAI / Grok, from https://console.x.ai/
#   OPENAI_API_KEY=
#   GEMINI_API_KEY=
#   ANTHROPIC_API_KEY=
# The provider is auto-detected from the key prefix; override with
# LLM_PROVIDER=groq|xai|openai|gemini|anthropic if needed.

# Session signing key. Required on any hosted deployment (Vercel/Render -- the
# host sets VERCEL or RENDER); generated per-process locally.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_random_hex_secret_here

# --- Where writable state lives --------------------------------------------
# Database, uploads, reports and the vector index all hang off DATA_DIR, so a
# host with a mounted disk needs one variable: DATA_DIR=/var/data. Defaults to
# the project directory locally and /tmp on serverless (nothing else is
# writable there). DB_PATH / UPLOAD_FOLDER / REPORTS_DIR can override it
# individually.
# DATA_DIR=

# --- Google sign-in (optional) ---------------------------------------------
# Create an "OAuth client ID" of type "Web application" at
# https://console.cloud.google.com/apis/credentials and add the callback URL to
# its Authorized redirect URIs:
#   local:  http://localhost:8000/auth/google/callback
#   hosted: https://<your-domain>/auth/google/callback
# Leave both blank to keep Google sign-in switched off -- the button then shows
# an "isn't available yet" toast instead of a link that cannot work.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. When blank the callback URL is derived from the incoming request,
# which keeps preview deployments working without extra config.
GOOGLE_REDIRECT_URI=
